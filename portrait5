<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>cosmic dream · pure fun</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: #060812;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: system-ui, sans-serif;
            padding: 1.2rem;
        }
        .card {
            background: #0b0f1a;
            padding: 1.2rem;
            border-radius: 2.8rem;
            box-shadow: 0 24px 48px rgba(0,0,0,0.9);
        }
        canvas {
            display: block;
            width: 600px;
            height: 600px;
            border-radius: 2.2rem;
            background: #0a0e1a;
            box-shadow: inset 0 0 0 1px rgba(255,220,190,0.03);
        }
        .caption {
            text-align: center;
            margin-top: 1rem;
            color: #6a6a8a;
            font-size: 0.75rem;
            letter-spacing: 2px;
            border-top: 1px solid #1a1f30;
            padding-top: 1rem;
            text-transform: uppercase;
        }
        .caption span {
            background: #121624;
            padding: 0.15rem 1.2rem;
            border-radius: 30px;
            color: #8a8aaa;
        }
        @media (max-width: 650px) {
            .card { padding: 0.8rem; border-radius: 2rem; }
            canvas { width: 100%; height: auto; aspect-ratio: 1/1; border-radius: 1.6rem; }
        }
    </style>
</head>
<body>
<div class="card">
    <canvas id="funCanvas" width="600" height="600"></canvas>
    <div class="caption"><span>✦  cosmic dream · just for fun  ✦</span></div>
</div>
<script>
    (function drawCosmicDream() {
        const canvas = document.getElementById('funCanvas');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');

        // --- deep space background ---
        const bgGrad = ctx.createRadialGradient(300, 300, 50, 300, 300, 450);
        bgGrad.addColorStop(0, '#1a1040');
        bgGrad.addColorStop(0.4, '#0f0a2a');
        bgGrad.addColorStop(1, '#060812');
        ctx.fillStyle = bgGrad;
        ctx.fillRect(0, 0, 600, 600);

        // --- stars (random but seeded for consistency) ---
        const starPositions = [
            [45, 80], [120, 30], [200, 60], [320, 20], [450, 40], [540, 70],
            [30, 150], [80, 200], [160, 180], [250, 140], [380, 160], [500, 130],
            [570, 180], [20, 280], [100, 300], [180, 270], [300, 250], [420, 290],
            [520, 260], [580, 320], [40, 400], [130, 380], [220, 420], [340, 390],
            [470, 410], [550, 380], [60, 500], [150, 480], [260, 520], [390, 500],
            [490, 530], [560, 480], [15, 550], [110, 570], [300, 580], [450, 570]
        ];
        
        ctx.save();
        starPositions.forEach(([x, y]) => {
            const size = Math.random() * 2 + 0.5;
            const brightness = Math.random() * 0.5 + 0.3;
            ctx.beginPath();
            ctx.arc(x, y, size, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(255, 255, 240, ${brightness})`;
            ctx.shadowColor = 'rgba(200, 180, 255, 0.1)';
            ctx.shadowBlur = 4;
            ctx.fill();
        });
        ctx.restore();

        // --- giant glowing planet ---
        ctx.save();
        ctx.shadowColor = 'rgba(150, 100, 255, 0.2)';
        ctx.shadowBlur = 60;
        ctx.beginPath();
        ctx.arc(300, 300, 120, 0, Math.PI * 2);
        const planetGrad = ctx.createRadialGradient(260, 260, 20, 300, 300, 120);
        planetGrad.addColorStop(0, '#ff6b9d');
        planetGrad.addColorStop(0.3, '#c44b8a');
        planetGrad.addColorStop(0.7, '#7a3b7a');
        planetGrad.addColorStop(1, '#2a1a4a');
        ctx.fillStyle = planetGrad;
        ctx.fill();
        ctx.restore();

        // --- planet rings ---
        ctx.save();
        ctx.shadowColor = 'rgba(200, 150, 255, 0.05)';
        ctx.shadowBlur = 20;
        ctx.translate(300, 300);
        ctx.rotate(-0.2);
        ctx.beginPath();
        ctx.ellipse(0, 0, 170, 30, 0, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(255, 200, 220, 0.2)';
        ctx.lineWidth = 6;
        ctx.stroke();
        ctx.beginPath();
        ctx.ellipse(0, 0, 185, 35, 0, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(200, 170, 255, 0.15)';
        ctx.lineWidth = 4;
        ctx.stroke();
        ctx.beginPath();
        ctx.ellipse(0, 0, 155, 25, 0, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(255, 150, 200, 0.15)';
        ctx.lineWidth = 3;
        ctx.stroke();
        ctx.restore();

        // --- smaller moon ---
        ctx.save();
        ctx.shadowColor = 'rgba(200, 200, 255, 0.1)';
        ctx.shadowBlur = 30;
        ctx.beginPath();
        ctx.arc(450, 180, 35, 0, Math.PI * 2);
        const moonGrad = ctx.createRadialGradient(440, 170, 10, 450, 180, 35);
        moonGrad.addColorStop(0, '#e8e0d0');
        moonGrad.addColorStop(0.5, '#b0a8a0');
        moonGrad.addColorStop(1, '#605a60');
        ctx.fillStyle = moonGrad;
        ctx.fill();
        // moon craters (fun details)
        ctx.shadowBlur = 4;
        ctx.beginPath();
        ctx.arc(440, 175, 6, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(80, 70, 80, 0.3)';
        ctx.fill();
        ctx.beginPath();
        ctx.arc(460, 190, 4, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(80, 70, 80, 0.25)';
        ctx.fill();
        ctx.beginPath();
        ctx.arc(445, 195, 3, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(80, 70, 80, 0.2)';
        ctx.fill();
        ctx.restore();

        // --- shooting star ---
        ctx.save();
        ctx.shadowColor = 'rgba(255, 200, 255, 0.3)';
        ctx.shadowBlur = 25;
        ctx.beginPath();
        ctx.moveTo(80, 80);
        ctx.lineTo(120, 110);
        ctx.lineTo(130, 100);
        ctx.closePath();
        ctx.fillStyle = 'rgba(255, 220, 255, 0.4)';
        ctx.fill();
        // trail
        ctx.shadowBlur = 40;
        ctx.beginPath();
        ctx.moveTo(80, 80);
        ctx.quadraticCurveTo(40, 50, 20, 30);
        ctx.strokeStyle = 'rgba(255, 180, 255, 0.1)';
        ctx.lineWidth = 2;
        ctx.stroke();
        ctx.restore();

        // --- cosmic jellyfish (because why not!) ---
        ctx.save();
        ctx.shadowColor = 'rgba(100, 200, 255, 0.05)';
        ctx.shadowBlur = 30;
        // bell
        ctx.beginPath();
        ctx.ellipse(150, 400, 40, 30, 0, 0, Math.PI * 2);
        const jellyGrad = ctx.createRadialGradient(140, 390, 10, 150, 400, 40);
        jellyGrad.addColorStop(0, 'rgba(100, 200, 255, 0.4)');
        jellyGrad.addColorStop(0.6, 'rgba(50, 150, 255, 0.25)');
        jellyGrad.addColorStop(1, 'rgba(20, 100, 200, 0.1)');
        ctx.fillStyle = jellyGrad;
        ctx.fill();
        // tentacles
        ctx.shadowBlur = 15;
        for (let i = 0; i < 12; i++) {
            const angle = (i / 12) * Math.PI * 2 - Math.PI/2;
            const x = 150 + Math.cos(angle) * 30;
            const y = 400 + Math.sin(angle) * 25;
            ctx.beginPath();
            ctx.moveTo(x, y);
            const wave = Math.sin(i * 0.5) * 15;
            ctx.quadraticCurveTo(x + wave, y + 30, x + wave * 0.7, y + 50);
            ctx.strokeStyle = `rgba(100, 200, 255, ${0.1 + Math.random() * 0.1})`;
            ctx.lineWidth = 1.5;
            ctx.stroke();
        }
        ctx.restore();

        // --- floating geometric shapes (fun!) ---
        // triangle
        ctx.save();
        ctx.shadowColor = 'rgba(255, 100, 200, 0.1)';
        ctx.shadowBlur = 20;
        ctx.translate(500, 420);
        ctx.rotate(0.3);
        ctx.beginPath();
        ctx.moveTo(0, -20);
        ctx.lineTo(20, 15);
        ctx.lineTo(-20, 15);
        ctx.closePath();
        ctx.fillStyle = 'rgba(255, 100, 200, 0.15)';
        ctx.fill();
        ctx.strokeStyle = 'rgba(255, 100, 200, 0.2)';
        ctx.lineWidth = 1;
        ctx.stroke();
        ctx.restore();

        // square
        ctx.save();
        ctx.shadowColor = 'rgba(100, 255, 200, 0.08)';
        ctx.shadowBlur = 15;
        ctx.translate(100, 520);
        ctx.rotate(-0.2);
        ctx.fillStyle = 'rgba(100, 255, 200, 0.08)';
        ctx.strokeStyle = 'rgba(100, 255, 200, 0.15)';
        ctx.lineWidth = 1;
        ctx.fillRect(-15, -15, 30, 30);
        ctx.strokeRect(-15, -15, 30, 30);
        ctx.restore();

        // --- nebula clouds (abstract) ---
        ctx.save();
        ctx.globalAlpha = 0.03;
        for (let i = 0; i < 5; i++) {
            const x = 100 + Math.random() * 400;
            const y = 100 + Math.random() * 400;
            const r = 100 + Math.random() * 150;
            const grad = ctx.createRadialGradient(x, y, 10, x, y, r);
            const colors = [
                ['#ff6b9d', '#ff0066'],
                ['#6b9dff', '#0066ff'],
                ['#9d6bff', '#6600ff'],
                ['#ff9d6b', '#ff6600'],
                ['#6bff9d', '#00ff66']
            ];
            const [c1, c2] = colors[i % colors.length];
            grad.addColorStop(0, c1);
            grad.addColorStop(1, c2);
            ctx.fillStyle = grad;
            ctx.beginPath();
            ctx.arc(x, y, r, 0, Math.PI * 2);
            ctx.fill();
        }
        ctx.restore();

        // --- tiny floating particles ---
        ctx.save();
        for (let i = 0; i < 30; i++) {
            const x = 50 + Math.random() * 500;
            const y = 50 + Math.random() * 500;
            const size = Math.random() * 2 + 1;
            ctx.beginPath();
            ctx.arc(x, y, size, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(255, 255, 255, ${Math.random() * 0.2 + 0.05})`;
            ctx.shadowColor = 'rgba(200, 200, 255, 0.02)';
            ctx.shadowBlur = 8;
            ctx.fill();
        }
        ctx.restore();

        // --- final glow overlay ---
        const glowOverlay = ctx.createRadialGradient(300, 300, 100, 300, 300, 350);
        glowOverlay.addColorStop(0, 'rgba(200, 150, 255, 0.02)');
        glowOverlay.addColorStop(0.5, 'rgba(100, 50, 200, 0.02)');
        glowOverlay.addColorStop(1, 'rgba(0, 0, 0, 0)');
        ctx.fillStyle = glowOverlay;
        ctx.fillRect(0, 0, 600, 600);

        // --- tiny signature ---
        ctx.fillStyle = 'rgba(255, 255, 255, 0.03)';
        ctx.font = '8px monospace';
        ctx.fillText('✦  just for fun  ✦', 490, 590);
    })();
</script>
</body>
</html>
