<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Color Swatches - Fart Goblin Tech</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
            background: #f4f5f7;
            padding: 2rem;
        }

        h1 {
            text-align: center;
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
            color: #1e1e2a;
        }

        .subtitle {
            text-align: center;
            font-size: 1.1rem;
            color: #666;
            margin-bottom: 2.5rem;
        }

        .scheme-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 2rem;
            max-width: 1400px;
            margin: 0 auto;
        }

        .scheme-card {
            background: #fff;
            border-radius: 16px;
            padding: 1.5rem;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            transition: transform 0.2s ease;
        }

        .scheme-card:hover {
            transform: translateY(-4px);
        }

        .scheme-name {
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 1rem;
            color: #1e1e2a;
            border-bottom: 1px solid #eee;
            padding-bottom: 0.5rem;
        }

        .swatch-row {
            display: flex;
            gap: 8px;
            margin-bottom: 12px;
            flex-wrap: wrap;
        }

        .swatch {
            flex: 1;
            min-width: 50px;
            height: 70px;
            border-radius: 8px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            font-size: 0.6rem;
            font-weight: 500;
            color: #fff;
            text-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
            padding: 4px;
            text-align: center;
            line-height: 1.3;
            border: 1px solid rgba(0, 0, 0, 0.06);
        }

        .swatch-light {
            color: #1e1e2a;
            text-shadow: none;
        }

        .swatch-hex {
            font-size: 0.55rem;
            opacity: 0.85;
            font-weight: 400;
        }

        .swatch-label {
            font-size: 0.55rem;
            opacity: 0.7;
            font-weight: 400;
        }

        .scheme-tag {
            display: inline-block;
            font-size: 0.65rem;
            background: #f0f0f0;
            padding: 2px 10px;
            border-radius: 12px;
            color: #555;
            margin-top: 6px;
        }

        .vibe {
            font-size: 0.8rem;
            color: #777;
            margin-top: 6px;
            font-style: italic;
        }

        .footer {
            text-align: center;
            margin-top: 3rem;
            color: #999;
            font-size: 0.85rem;
        }

        /* Dark background for light swatches */
        .swatch-dark-bg {
            border: 1px solid #ddd;
        }

        /* Responsive */
        @media (max-width: 600px) {
            body { padding: 1rem; }
            .scheme-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

    <h1>🎨 Color Scheme Swatches</h1>
    <p class="subtitle">10 palettes for FART Goblin Tech — pick the vibe that fits your brand</p>

    <div class="scheme-grid">

        <!-- ============================================================ -->
        <!-- 1. CURRENT (Modern & Airy) — your existing palette -->
        <!-- ============================================================ -->
        <div class="scheme-card">
            <div class="scheme-name">🌿 1. Modern &amp; Airy <span class="scheme-tag">current</span></div>
            <div class="swatch-row">
                <div class="swatch" style="background:#00b894;">Primary<br><span class="swatch-hex">#00b894</span></div>
                <div class="swatch" style="background:#6c5ce7;">Secondary<br><span class="swatch-hex">#6c5ce7</span></div>
                <div class="swatch" style="background:#fd79a8;">Accent<br><span class="swatch-hex">#fd79a8</span></div>
                <div class="swatch" style="background:#f8f9fa; color:#1e1e2a; border:1px solid #ddd;">Bg<br><span class="swatch-hex">#f8f9fa</span></div>
                <div class="swatch" style="background:#2d3436;">Text<br><span class="swatch-hex">#2d3436</span></div>
            </div>
            <div class="vibe">🌱 Fresh · Clean · Approachable</div>
